{
  "name": "pty-time",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "PTY Time - videojuego panameño de accion y supervivencia zombi en pixel art",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test \"tests/*.test.js\"",
    "assets": "python tools/generate_assets.py",
    "deploy:vercel": "vercel deploy --prod --yes --project pty-time --create-if-missing"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "vercel": "^65.12.0",
    "vite": "^7.1.0"
  }
}
